# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 Git에 올리지 않는다.
QUIZ_DOMAIN=h-jin.store

# 학습지 접속 비밀번호 (브라우저 로그인 창에 입력. 아이디는 아무거나)
QUIZ_PASSWORD=

# ── 아래는 메모리 4GB 이상인 서버에서 SQL 실행까지 켤 때만 ──
# (docker compose --profile sql up -d --build 로 실행)
# QUIZ_SQL_HOST=mssql,1433
# sa 비밀번호: 8자 이상, 대문자·소문자·숫자·기호 중 3종류 이상
# MSSQL_SA_PASSWORD=
# QUIZ_MEMORY=1500m
